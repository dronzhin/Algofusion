{
  "document_type": "contract",
  "description": "Договор оказания услуг / поставки товаров",
  "json_schema": {
    "type": "object",
    "properties": {
      "document_type": {"type": "string", "enum": ["contract"]},
      "document_number": {"type": "string", "description": "Номер договора"},
      "document_date": {"type": "string", "format": "date", "description": "Дата заключения (ГГГГ-ММ-ДД)"},
      "seller": {"type": "string", "description": "Продавец/Исполнитель (полное наименование)"},
      "buyer": {"type": "string", "description": "Покупатель/Заказчик (полное наименование)"},
      "total_amount": {"type": "number", "description": "Общая сумма договора"},
      "vat_amount": {"type": "number", "description": "Сумма НДС"},
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "description": {"type": "string"},
            "quantity": {"type": "number"},
            "unit_price": {"type": "number"},
            "total": {"type": "number"}
          }
        }
      },
      "subject": {"type": "string", "description": "Предмет договора (краткое описание)"}
    },
    "required": ["document_number", "document_date", "seller", "buyer", "subject"],
    "additionalProperties": false
  },
  "example": {
    "document_type": "contract",
    "document_number": "ДГ-2024-001",
    "document_date": "2024-03-15",
    "seller": "ООО \"Ромашка\", УНП 190234567",
    "buyer": "ООО \"Вектор\", УНП 191234890",
    "total_amount": 150000,
    "vat_amount": 25000,
    "items": [
      {"description": "Консультационные услуги", "quantity": 100, "unit_price": 1200, "total": 120000},
      {"description": "Техническая поддержка", "quantity": 12, "unit_price": 2500, "total": 30000}
    ],
    "subject": "Оказание консультационных и технических услуг в области информационных технологий"
  },
  "prompt_hints": "Даты в формате ГГГГ-ММ-ДД. Суммы — числами без пробелов. Если договор рамочный (без конкретной суммы) — укажи null в total_amount. Предмет договора извлекай как краткую выжимку (1-2 предложения)."
}