# .env
# ============================================================================
# ALGOFUSION - Базовые настройки (шаблон)
# ============================================================================

# ----------------------------------------------------------------------------
# 🏷 Идентификаторы и версии
# ----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=algofusion
APP_VERSION=0.1.0
ENVIRONMENT=development  # development, staging, production

# ----------------------------------------------------------------------------
# 🗄 Redis
# ----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # ← Заполнить в продакшене

# ----------------------------------------------------------------------------
# 📁 Файловая система
# ----------------------------------------------------------------------------
# Пути ВНУТРИ контейнеров
SHARED_FILES_PATH=/shared/files
EXTERNAL_MONITOR_PATH=/external/incoming

# Пути НА ХОСТЕ (для volumes)
HOST_SHARED_FILES_PATH=./shared/files
HOST_INCOMING_PATH=/home/dmitry/incoming  # ← Заменить на ваш путь

# ----------------------------------------------------------------------------
# 👁 Мониторинг папки
# ----------------------------------------------------------------------------
MONITOR_INTERVAL=5  # секунд
MONITOR_PATTERNS=*.pdf,*.png,*.jpg,*.jpeg,*.doc,*.docx,*.txt

# ----------------------------------------------------------------------------
# 👷 Воркеры
# ----------------------------------------------------------------------------
WORKER_TIMEOUT=300  # секунд на задачу
WORKER_MAX_RETRIES=3
WORKER_CONCURRENCY=1  # задач параллельно на воркер

# ----------------------------------------------------------------------------
# 🔤 OCR настройки
# ----------------------------------------------------------------------------
OCR_ENGINE=tesseract  # tesseract, easyocr, paddle
OCR_LANGS=rus+eng
OCR_DPI=300

# ----------------------------------------------------------------------------
# 🤖 LLM настройки
# ----------------------------------------------------------------------------
LLM_PROVIDER=ollama  # ollama, openai, anthropic
LLM_MODEL=mistral:7b  # или gpt-4, claude-3 и т.д.
LLM_ENDPOINT=http://ollama:11434  # для ollama
LLM_API_KEY=  # для облачных провайдеров
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ----------------------------------------------------------------------------
# 📤 Экспорт в 1С
# ----------------------------------------------------------------------------
EXPORT_1C_ENABLED=false
EXPORT_1C_MODE=manual  # manual, auto, batch
EXPORT_1C_ENDPOINT=  # URL вашего 1С HTTP-сервиса
EXPORT_1C_AUTH_LOGIN=
EXPORT_1C_AUTH_PASSWORD=
EXPORT_1C_BATCH_SIZE=10

# ----------------------------------------------------------------------------
# 🪵 Логирование
# ----------------------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_FORMAT=standard  # standard, json (для ELK/CloudWatch)
LOG_FILE_MAX_SIZE_MB=100
LOG_FILE_BACKUP_COUNT=5

# ----------------------------------------------------------------------------
# 🌐 UI (Streamlit)
# ----------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_THEME=light  # light, dark
STREAMLIT_MAX_UPLOAD_SIZE_MB=100

# ----------------------------------------------------------------------------
# 🔐 Безопасность (продакшен)
# ----------------------------------------------------------------------------
# Генерировать через: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
API_TOKEN_TTL_HOURS=24

# ----------------------------------------------------------------------------
# 📊 Мониторинг и метрики
# ----------------------------------------------------------------------------
METRICS_ENABLED=false
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# ----------------------------------------------------------------------------
# 🎨 UI настройки (дефолты для нового пользователя)
# ----------------------------------------------------------------------------
UI_AUTO_REFRESH_ENABLED=true
UI_AUTO_REFRESH_INTERVAL_SEC=5
UI_AUTO_REFRESH_MIN_SEC=5
UI_AUTO_REFRESH_MAX_SEC=60


UID=1000
GID=1000
