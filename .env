# .env
# ============================================================================
# ALGOFUSION - Конфигурация окружения
# ============================================================================

# ----------------------------------------------------------------------------
# 🏷 Идентификаторы и версии
# ----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=algofusion
APP_VERSION=0.1.0
ENVIRONMENT=development  # development, staging, production

# ----------------------------------------------------------------------------
# 🗄 Redis
# ----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# 📁 Файловая система
# ----------------------------------------------------------------------------
# Пути ВНУТРИ контейнеров
SHARED_FILES_PATH=/shared/files
EXTERNAL_MONITOR_PATH=/external/incoming

# Пути НА ХОСТЕ (для volumes)
HOST_SHARED_FILES_PATH=/home/dmitry/alg/files
HOST_INCOMING_PATH=/home/dmitry/alg/incoming

# ----------------------------------------------------------------------------
# 👁 Мониторинг папки
# ----------------------------------------------------------------------------
MONITOR_INTERVAL=5
MONITOR_PATTERNS=*.pdf,*.png,*.jpg,*.jpeg,*.doc,*.docx,*.txt

# ----------------------------------------------------------------------------
# 👷 Воркеры
# ----------------------------------------------------------------------------
WORKER_TIMEOUT=300
WORKER_MAX_RETRIES=3
WORKER_CONCURRENCY=1

# ----------------------------------------------------------------------------
# 🔤 OCR настройки
# ----------------------------------------------------------------------------
OCR_ENGINE=tesseract
OCR_LANGS=rus+eng
OCR_DPI=300

# ----------------------------------------------------------------------------
# 🤖 LLM настройки (ОБНОВЛЕНО)
# ----------------------------------------------------------------------------
LLM_PROVIDER=ollama

# === Основная модель (по умолчанию для экстракции) ===
LLM_MODEL=qwen2.5:7b

# === Endpoint Ollama ===
LLM_ENDPOINT=http://ollama:11434
LLM_API_KEY=

# === Параметры генерации ===
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_JSON_MODE=true

# === Классификация ===
LLM_CLASSIFY_THRESHOLD=0.85
LLM_PENDING_TIMEOUT_MIN=30
LLM_PENDING_RECHECK_SEC=30
LLM_MAX_PENDING_REQUEUES=20

# === Модели для автозагрузки в Ollama ===
# 🔹 КЛАССИФИКАЦИЯ (~2B) - быстрые, для определения типа документа
# 🔹 ЭКСТРАКЦИЯ (~7-8B) - мощные, с поддержкой json_mode
LLM_MODELS=qwen2.5:1.5b,gemma2:2b,phi3:mini-3.8b,qwen2.5:7b,llama3.1:8b

# === Модель для классификации (быстрая, ~2B) ===
LLM_CLASSIFIER_MODEL=qwen2.5:1.5b

# === Модель для экстракции данных (мощная, ~7-8B) ===
LLM_EXTRACTOR_MODEL=qwen2.5:7b

# === Разрешённые типы документов ===
LLM_ALLOWED_DOC_TYPES=contract,invoice,invoice_protocol,waybill,payment,order,unknown

# === Пути и форматы ===
LLM_SCHEMAS_PATH=/app/workers/LLM/schemas
LLM_OUTPUT_FORMAT=xml

# === Retry-логика ===
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2.0

# ----------------------------------------------------------------------------
# 🤖 LLM настройки
# ----------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_ENDPOINT=http://ollama:11434
LLM_API_KEY=
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_JSON_MODE=true

# Классификация
LLM_CLASSIFY_THRESHOLD=0.85
LLM_PENDING_TIMEOUT_MIN=30
LLM_PENDING_RECHECK_SEC=30
LLM_MAX_PENDING_REQUEUES=20

# Модели для автозагрузки
LLM_MODELS=qwen2.5:1.5b,gemma2:2b,phi3:mini-3.8b,qwen2.5:7b,llama3.1:8b
LLM_CLASSIFIER_MODEL=qwen2.5:1.5b
LLM_EXTRACTOR_MODEL=qwen2.5:7b
LLM_ALLOWED_DOC_TYPES=dogovor,schet,tovarnaya_nakladnaya,schet_protokol,unknown
LLM_SCHEMAS_PATH=/app/workers/LLM/schemas
LLM_OUTPUT_FORMAT=xml
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2.0

# ----------------------------------------------------------------------------
# 🧠 Ollama настройки (GPU / CPU Strategy)
# ----------------------------------------------------------------------------
OLLAMA_HOST=0.0.0.0
OLLAMA_KEEP_ALIVE=24h
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_NUM_PARALLEL=2

# 🔹 GPU-стратегия:
# -1 = авто-детект (использовать все доступные GPU, иначе CPU)
#  0 = только CPU
OLLAMA_NUM_GPU=-1
OLLAMA_NUM_GPU_LAYERS=-1

# Ресурсы
OLLAMA_CPU_LIMIT=4
OLLAMA_MEMORY_LIMIT=16G
LLM_WORKER_CPU_LIMIT=2
LLM_WORKER_MEMORY_LIMIT=4G

# ----------------------------------------------------------------------------
# 📤 Экспорт (ОТКЛЮЧЕНО)
# ----------------------------------------------------------------------------
EXPORT_1C_ENABLED=false
EXPORT_1C_MODE=manual
EXPORT_1C_ENDPOINT=
EXPORT_1C_AUTH_LOGIN=
EXPORT_1C_AUTH_PASSWORD=
EXPORT_1C_BATCH_SIZE=10

# ----------------------------------------------------------------------------
# 🪵 Логирование
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=standard
LOG_FILE_MAX_SIZE_MB=100
LOG_FILE_BACKUP_COUNT=5

# ----------------------------------------------------------------------------
# 🌐 UI (Streamlit)
# ----------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_THEME=light
STREAMLIT_MAX_UPLOAD_SIZE_MB=100

# ----------------------------------------------------------------------------
# 🔐 Безопасность
# ----------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
API_TOKEN_TTL_HOURS=24

# ----------------------------------------------------------------------------
# 📊 Мониторинг
# ----------------------------------------------------------------------------
METRICS_ENABLED=false
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# ----------------------------------------------------------------------------
# 🎨 UI настройки
# ----------------------------------------------------------------------------
UI_AUTO_REFRESH_ENABLED=true
UI_AUTO_REFRESH_INTERVAL_SEC=5
UI_AUTO_REFRESH_MIN_SEC=5
UI_AUTO_REFRESH_MAX_SEC=60

# === Настройки процессора ===
PROCESSOR_PDF_DPI=600
PROCESSOR_BG_THRESHOLD=128
PROCESSOR_BIN_THRESHOLD=128
PROCESSOR_MEDIAN_ITER=5
PROCESSOR_MEDIAN_SIZE=3
PROCESSOR_ROT_ANGLE_THRESH=0.5
PROCESSOR_ROT_SCALE=1.0

# ----------------------------------------------------------------------------
# 👤 Пользователь контейнеров (совпадение прав с хостом)
# ----------------------------------------------------------------------------
UID=1000
GID=1000